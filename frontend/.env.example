# Firebase (web config, exposed to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Groq (shipped in the client bundle: fine for development, see ARCHITECTURE.md)
NEXT_PUBLIC_GROQ_API_KEY=

# Gmail (OAuth "Web application" client; see ARCHITECTURE.md for setup)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Outlook (Entra app registration, "Single-page application" platform)
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
